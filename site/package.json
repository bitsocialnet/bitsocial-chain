{
  "name": "bitsocial-chain",
  "version": "0.1.0",
  "private": true,
  "description": "Bitsocial Chain landing site (BSO token and L2 appchain).",
  "license": "AGPL-3.0-only",
  "author": "Bitsocial Forge",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-chain.mjs",
    "build": "tsgo --noEmit --project tsconfig.json && vite build",
    "build:profile": "vite build --mode profiling",
    "typecheck": "tsgo --noEmit --project tsconfig.json",
    "test": "node --test scripts/__tests__/*.node-test.mjs",
    "rich-list:snapshot": "node scripts/generate-bso-holders.mjs",
    "rich-list:history": "node scripts/generate-bso-holder-history.mjs",
    "chart:snapshot": "node scripts/generate-bso-price-history.mjs",
    "chart:bones": "node scripts/capture-bones.mjs chart",
    "rich-list:bones": "node scripts/capture-bones.mjs rich-list",
    "deps:check-pinned": "node scripts/check-pinned-versions.mjs",
    "deps:check-hardened": "YARN_ENABLE_HARDENED_MODE=1 yarn install --immutable",
    "deps:install:hardened": "YARN_ENABLE_HARDENED_MODE=1 yarn install",
    "knip": "knip --production --include dependencies,unlisted,binaries --no-progress",
    "knip:full": "knip --no-progress --no-exit-code",
    "lint": "oxlint --config oxlint.json --react-plugin",
    "lint:fix": "oxlint --config oxlint.json --fix --react-plugin",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "doctor": "react-doctor . -y",
    "doctor:verbose": "react-doctor . --verbose -y",
    "doctor:scan": "react-doctor scan",
    "doctor:check": "node scripts/react-perf/doctor-check.mjs",
    "perf:check": "node scripts/react-perf/runner.mjs check",
    "perf:record": "node scripts/react-perf/runner.mjs record",
    "perf:test": "node scripts/react-perf/runner.mjs selftest",
    "perf:install": "node scripts/react-perf/install-browser.mjs",
    "agent:verify": "yarn build && yarn doctor:check && yarn perf:check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "boneyard-js": "1.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
