    "react-doctor": "0.9.14",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.2",
    "vite": "8.1.6"
  },
  "resolutions": {
    "@types/react@npm:*": "npm:19.2.14",
    "browserslist": "4.28.7",
